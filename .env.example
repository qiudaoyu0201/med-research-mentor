# Optional compatible model provider configuration.
# Leave unset to use the local provider configured by the application.
TUTOR_PROVIDER=compatible
TUTOR_MODEL_BASE_URL=https://example.invalid/v1
TUTOR_MODEL=your-model-name
TUTOR_MODEL_API_KEY=replace-with-local-secret
TUTOR_MODEL_IMAGES=false
TUTOR_MODEL_OUTPUT_MODE=json_object
TUTOR_MODEL_MAX_INPUT_CHARS=120000
TUTOR_MODEL_MAX_OUTPUT_TOKENS=6000

# Optional local storage and server settings.
# TUTOR_DATA_DIR=./data
# PORT=4317
